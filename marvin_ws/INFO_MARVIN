Actualizar Código de Marvin (Afuera del docker)---------------------
cd marvin
git pull origin main
# Actualizar dockerfile(Si hay cambios):
cd /marvin
# Eliminar imagen antigua
sudo docker rmi marvin:latest -f
# Reconstruir Docker (puede tomar 5-10 minutos)
sudo docker build . -t marvin:latest

Iniciar Docker------------------------------------------------------
# Con mando conectado:
sudo docker run -it --net=host --device=/dev/input/event0 --device=/dev/input/event1 --device=/dev/input/event2 --device=/dev/input/js0 --device=/dev/myserial --device=/dev/rplidar --env="DISPLAY" --env="QT_X11_NO_MITSHM=1" -v /tmp/.X11-unix:/tmp/.X11-unix marvin:latest /bin/bash
# Sin mando conectado:
sudo docker run -it --net=host --device=/dev/input/event0 --device=/dev/input/event1 --device=/dev/myserial --device=/dev/rplidar --env="DISPLAY" --env="QT_X11_NO_MITSHM=1" -v /tmp/.X11-unix:/tmp/.X11-unix marvin:latest /bin/bash
Con camaras
sudo docker run -it --net=host \
  --device=/dev/input/event0 \
  --device=/dev/input/event1 \
  --device=/dev/myserial \
  --device=/dev/rplidar \
  --device=/dev/video0 \
  --device=/dev/video1 \
  --env="DISPLAY" \
  --env="QT_X11_NO_MITSHM=1" \
  -v /tmp/.X11-unix:/tmp/.X11-unix \
  marvin:latest /bin/bash


